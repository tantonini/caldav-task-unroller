#!/usr/bin/env python3
"""CalDAV Task Unroller: Generates recurring tasks from CalDAV RRULE templates."""

# pylint: disable=invalid-name

import json
import os
import sys
from datetime import datetime

import caldav


def load_config(config_path="config.json"):
    """Load configuration from a JSON file."""
    try:
        with open(config_path, "r", encoding="utf-8") as file:
            return json.load(file)
    except FileNotFoundError:
        print(f"Error: Configuration file '{config_path}' not found.")
        sys.exit(1)
    except json.JSONDecodeError as err:
        print(f"Error parsing configuration file: {err}")
        sys.exit(1)


def load_state(filepath):
    """Load previous task state from JSON file with crash protection."""
    if not os.path.exists(filepath):
        return {}
    try:
        with open(filepath, "r", encoding="utf-8") as file:
            return json.load(file)
    except json.JSONDecodeError as err:
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_path = f"{filepath}.corrupted_{timestamp}"
        print(f"Fatal error: Could not parse state file '{filepath}': {err}")

        try:
            os.rename(filepath, backup_path)
            print(f"Backed up corrupted state file to '{backup_path}'.")
        except OSError as backup_err:
            print(f"Could not backup corrupted state file: {backup_err}")

        print("Aborting execution to prevent data loss or duplicate archiving.")
        sys.exit(1)


def save_state(filepath, state):
    """Save the current task state to a JSON file."""
    with open(filepath, "w", encoding="utf-8") as file:
        json.dump(state, file, indent=4)


def main():
    """Main execution flow: load config, connect, and manage state."""
    config = load_config()

    url = config.get("caldav_url")
    user = config.get("caldav_username")
    pwd = config.get("caldav_password")
    cal_name = config.get("calendar_name")
    state_file = config.get("state_file", "state.json")

    if not all([url, user, pwd, cal_name]):
        print("Error: Missing one or more required keys in config.json.")
        sys.exit(1)

    # pylint: disable=broad-exception-caught
    try:
        client = caldav.DAVClient(url=url, username=user, password=pwd)
        principal = client.principal()

        calendars = principal.calendars()
        target_cal = next((c for c in calendars if c.name == cal_name), None)

        if not target_cal:
            available = [c.name for c in calendars]
            print(f"Error: Missing required calendar '{cal_name}'.")
            print(f"Available calendars on server: {available}")
            sys.exit(1)

        print(f"Successfully located calendar: '{target_cal.name}'.")

        # Initialize memory
        state = load_state(state_file)
        print(f"Loaded state with {len(state)} tracked tasks.")

        # TODO: Fetch tasks, compare due dates, and archive completed ones
        # (This will be the focus of the next commit)

        # Persist memory
        save_state(state_file, state)
        print("Execution completed. State saved.")

    except Exception as err:
        print(f"Fatal error: {err}")
        sys.exit(1)


if __name__ == "__main__":
    main()
