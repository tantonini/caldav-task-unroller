#!/usr/bin/env python3
"""CalDAV Task Unroller: Generates recurring tasks from CalDAV RRULE templates."""

# pylint: disable=invalid-name

import argparse
import json
import os
import sys
import uuid
from datetime import datetime, timezone

import caldav


def parse_args():
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(
        description="Archive completed occurrences of recurring CalDAV tasks."
    )
    parser.add_argument(
        "-d",
        "--dry-run",
        action="store_true",
        help="Simulate execution without modifying the server or state file.",
    )
    parser.add_argument(
        "-c",
        "--config",
        default="config.json",
        help="Path to configuration file (default: config.json).",
    )
    return parser.parse_args()


def load_config(config_path="config.json"):
    """Load configuration from a JSON file."""
    try:
        with open(config_path, "r", encoding="utf-8") as file:
            return json.load(file)
    except FileNotFoundError:
        print(f"Error: Configuration file '{config_path}' not found.")
        sys.exit(1)
    except json.JSONDecodeError as err:
        print(f"Error parsing configuration file: {err}")
        sys.exit(1)


def load_state(filepath):
    """Load previous task state from JSON file with crash protection."""
    if not os.path.exists(filepath):
        return {}
    try:
        with open(filepath, "r", encoding="utf-8") as file:
            return json.load(file)
    except json.JSONDecodeError as err:
        timestamp = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
        backup_path = f"{filepath}.corrupted_{timestamp}"
        print(f"Fatal error: Could not parse state file '{filepath}': {err}")

        try:
            os.rename(filepath, backup_path)
            print(f"Backed up corrupted state file to '{backup_path}'.")
        except OSError as backup_err:
            print(f"Could not backup corrupted state file: {backup_err}")

        print("Aborting execution to prevent data loss or duplicate archiving.")
        sys.exit(1)


def save_state(filepath, state):
    """Save the current task state to a JSON file."""
    with open(filepath, "w", encoding="utf-8") as file:
        json.dump(state, file, indent=4)


def parse_recurring_task(todo):
    """
    Extract key attributes from a CalDAV VTODO component if it is recurring.

    Returns dict with task info, or None if the task is not recurring or missing DUE.
    """
    vtodo = todo.icalendar_component
    if not vtodo.get("rrule"):
        return None

    uid = str(vtodo.get("uid"))
    summary = str(vtodo.get("summary", "Untitled Task"))

    due_prop = vtodo.get("due")
    due_str = due_prop.dt.isoformat() if due_prop else None

    last_mod_prop = vtodo.get("last-modified")
    last_mod_str = last_mod_prop.dt.isoformat() if last_mod_prop else None

    if not due_str:
        return None

    return {
        "uid": uid,
        "summary": summary,
        "due": due_str,
        "last_modified": last_mod_str,
    }


def format_ical_datetime(dt_str):
    """Format an ISO date or datetime string into a valid iCalendar DATE-TIME string (UTC)."""
    if not dt_str:
        return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")

    # If simple DATE (e.g., "2026-08-11"), convert to UTC DATE-TIME at midnight
    if len(dt_str) == 10 and "T" not in dt_str:
        return dt_str.replace("-", "") + "T000000Z"

    try:
        dt = datetime.fromisoformat(dt_str)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        else:
            dt = dt.astimezone(timezone.utc)
        return dt.strftime("%Y%m%dT%H%M%SZ")
    except ValueError:
        clean = dt_str.replace("-", "").replace(":", "")
        if "T" in clean:
            if "+" in clean:
                clean = clean.split("+")[0]
            if not clean.endswith("Z"):
                clean += "Z"
            return clean
        return clean + "T000000Z"


def connect_caldav(config):
    """Establish connection with the CalDAV server and return the principal."""
    url = config.get("caldav_url")
    user = config.get("caldav_username")
    pwd = config.get("caldav_password")

    if not all([url, user, pwd]):
        print("Error: Missing credentials or server URL in config.json.")
        sys.exit(1)

    client = caldav.DAVClient(url=url, username=user, password=pwd)
    return client.principal()


def get_calendar(principal, cal_name):
    """Locate and return the target calendar by name."""
    calendars = principal.calendars()
    target_cal = next((c for c in calendars if c.get_display_name() == cal_name), None)

    if not target_cal:
        available = [c.get_display_name() for c in calendars]
        print(f"Error: Missing required calendar '{cal_name}'.")
        print(f"Available calendars on server: {available}")
        sys.exit(1)

    return target_cal


def create_completed_archive(target_cal, summary, original_due, completed_at):
    """Create a standalone COMPLETED VTODO task on the CalDAV calendar."""
    archive_uid = f"archive-{uuid.uuid4()}"
    now_utc = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")

    completed_str = format_ical_datetime(completed_at)
    due_str = format_ical_datetime(original_due)

    vtodo_ics = (
        "BEGIN:VCALENDAR\r\n"
        "VERSION:2.0\r\n"
        "PRODID:-//CalDAV Task Unroller//EN\r\n"
        "BEGIN:VTODO\r\n"
        f"UID:{archive_uid}\r\n"
        f"DTSTAMP:{now_utc}\r\n"
        f"SUMMARY:{summary}\r\n"
        "STATUS:COMPLETED\r\n"
        f"COMPLETED:{completed_str}\r\n"
        f"DUE:{due_str}\r\n"
        "END:VTODO\r\n"
        "END:VCALENDAR\r\n"
    )

    target_cal.add_todo(vtodo_ics)
    print(f"  -> Archived standalone task: '{summary}' (UID: {archive_uid})")


def detect_completed_occurrences(target_cal, state):
    """Scan recurring tasks and return detected completed occurrences."""
    todos = target_cal.todos()
    recurring_count = 0
    completions = []

    for todo in todos:
        info = parse_recurring_task(todo)
        if not info:
            continue

        recurring_count += 1
        uid = info["uid"]
        current_due = info["due"]

        if uid in state:
            prev_due = state[uid].get("due")
            if prev_due and current_due != prev_due:
                completions.append(
                    {
                        "summary": info["summary"],
                        "original_due": prev_due,
                        "completed_at": info["last_modified"],
                    }
                )

        state[uid] = info

    print(
        f"Scanned {len(todos)} items ({recurring_count} recurring). "
        f"Detected {len(completions)} completed occurrence(s)."
    )
    return completions


def archive_completions(target_cal, completions, dry_run=False):
    """Push standalone COMPLETED tasks for each detected occurrence."""
    for item in completions:
        if dry_run:
            print(
                f"[DRY-RUN] Would archive: '{item['summary']}' (Due: {item['original_due']})"
            )
        else:
            print(f"Archiving completed occurrence: '{item['summary']}'")
            create_completed_archive(
                target_cal=target_cal,
                summary=item["summary"],
                original_due=item["original_due"],
                completed_at=item["completed_at"],
            )


def main():
    """Main execution flow: load config, inspect tasks, update state."""
    args = parse_args()
    config = load_config(args.config)
    cal_name = config.get("calendar_name")
    state_file = config.get("state_file", "state.json")

    if not cal_name:
        print("Error: Missing 'calendar_name' key in config.json.")
        sys.exit(1)

    if args.dry_run:
        print("=== DRY RUN MODE ENABLED (No changes will be saved) ===")

    # pylint: disable=broad-exception-caught
    try:
        principal = connect_caldav(config)
        target_cal = get_calendar(principal, cal_name)
        print(f"Successfully located calendar: '{target_cal.get_display_name()}'.")

        state = load_state(state_file)
        print(f"Loaded state with {len(state)} tracked tasks.")

        completions = detect_completed_occurrences(target_cal, state)
        if completions:
            archive_completions(target_cal, completions, dry_run=args.dry_run)

        if not args.dry_run:
            save_state(state_file, state)
            print("Execution completed. State saved.")
        else:
            print("Dry run completed. State was NOT saved.")

    except Exception as err:
        print(f"Fatal error: {err}")
        sys.exit(1)


if __name__ == "__main__":
    main()
