#!/usr/bin/env python3
"""CalDAV Task Unroller: Generates recurring tasks from CalDAV RRULE templates."""

# pylint: disable=invalid-name

import json
import os
import sys
from datetime import datetime

import caldav


def load_config(config_path="config.json"):
    """Load configuration from a JSON file."""
    try:
        with open(config_path, "r", encoding="utf-8") as file:
            return json.load(file)
    except FileNotFoundError:
        print(f"Error: Configuration file '{config_path}' not found.")
        sys.exit(1)
    except json.JSONDecodeError as err:
        print(f"Error parsing configuration file: {err}")
        sys.exit(1)


def load_state(filepath):
    """Load previous task state from JSON file with crash protection."""
    if not os.path.exists(filepath):
        return {}
    try:
        with open(filepath, "r", encoding="utf-8") as file:
            return json.load(file)
    except json.JSONDecodeError as err:
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_path = f"{filepath}.corrupted_{timestamp}"
        print(f"Fatal error: Could not parse state file '{filepath}': {err}")

        try:
            os.rename(filepath, backup_path)
            print(f"Backed up corrupted state file to '{backup_path}'.")
        except OSError as backup_err:
            print(f"Could not backup corrupted state file: {backup_err}")

        print("Aborting execution to prevent data loss or duplicate archiving.")
        sys.exit(1)


def save_state(filepath, state):
    """Save the current task state to a JSON file."""
    with open(filepath, "w", encoding="utf-8") as file:
        json.dump(state, file, indent=4)


def parse_recurring_task(todo):
    """
    Extract key attributes from a CalDAV VTODO component if it is recurring.

    Returns dict with task info, or None if the task is not recurring or missing DUE.
    """
    vtodo = todo.icalendar_component
    if not vtodo.get("rrule"):
        return None

    uid = str(vtodo.get("uid"))
    summary = str(vtodo.get("summary", "Untitled Task"))

    due_prop = vtodo.get("due")
    due_str = due_prop.dt.isoformat() if due_prop else None

    last_mod_prop = vtodo.get("last-modified")
    last_mod_str = last_mod_prop.dt.isoformat() if last_mod_prop else None

    if not due_str:
        return None

    return {
        "uid": uid,
        "summary": summary,
        "due": due_str,
        "last_modified": last_mod_str,
    }


def connect_caldav(config):
    """Establish connection with the CalDAV server and return the principal."""
    url = config.get("caldav_url")
    user = config.get("caldav_username")
    pwd = config.get("caldav_password")

    if not all([url, user, pwd]):
        print("Error: Missing credentials or server URL in config.json.")
        sys.exit(1)

    client = caldav.DAVClient(url=url, username=user, password=pwd)
    return client.principal()


def get_calendar(principal, cal_name):
    """Locate and return the target calendar by name."""
    calendars = principal.calendars()
    target_cal = next((c for c in calendars if c.get_display_name() == cal_name), None)

    if not target_cal:
        available = [c.get_display_name() for c in calendars]
        print(f"Error: Missing required calendar '{cal_name}'.")
        print(f"Available calendars on server: {available}")
        sys.exit(1)

    return target_cal


def check_task_completions(target_cal, state):
    """Scan recurring tasks and detect completed occurrences."""
    todos = target_cal.todos()
    recurring_count = 0
    detected_completions = []

    for todo in todos:
        info = parse_recurring_task(todo)
        if not info:
            continue

        recurring_count += 1
        uid = info["uid"]
        current_due = info["due"]

        if uid in state:
            prev_due = state[uid].get("due")
            if prev_due and current_due != prev_due:
                print(f"Detected completed occurrence: '{info['summary']}'")
                print(f"  Previous DUE: {prev_due} -> New DUE: {current_due}")
                detected_completions.append(
                    {
                        "summary": info["summary"],
                        "completed_at": info["last_modified"],
                        "original_due": prev_due,
                    }
                )

        state[uid] = info

    print(
        f"Scanned {len(todos)} items ({recurring_count} recurring). "
        f"Detected {len(detected_completions)} completed occurrence(s)."
    )
    return detected_completions


def main():
    """Main execution flow: load config, inspect tasks, update state."""
    config = load_config()
    cal_name = config.get("calendar_name")
    state_file = config.get("state_file", "state.json")

    if not cal_name:
        print("Error: Missing 'calendar_name' key in config.json.")
        sys.exit(1)

    # pylint: disable=broad-exception-caught
    try:
        principal = connect_caldav(config)
        target_cal = get_calendar(principal, cal_name)
        print(f"Successfully located calendar: '{target_cal.get_display_name()}'.")

        state = load_state(state_file)
        print(f"Loaded state with {len(state)} tracked tasks.")

        _ = check_task_completions(target_cal, state)

        save_state(state_file, state)
        print("Execution completed. State saved.")

    except Exception as err:
        print(f"Fatal error: {err}")
        sys.exit(1)


if __name__ == "__main__":
    main()
